# Local eval configuration. Copy this file to .env in the repository root and
# fill in the values; .env is gitignored and never committed.
#
# The eval scenario entrypoints (TestScenarios, TestKubernetesScenarios) load
# the repository-root .env before running, so you can run the agent scenarios
# without prefixing every command with the key. A variable already set in the
# environment always wins over the file.

# Required to run the agent scenarios.
ANTHROPIC_API_KEY=

# Optional: point at a claude binary other than `claude` on PATH.
# EVAL_AGENT_BINARY=

# Optional: restrict a run to specific scenario IDs (comma-separated).
# EVAL_SCENARIOS=instr-go-http,ottl-redaction

# Optional: write per-scenario verdict JSON (with cost and evidence paths)
# to this directory.
# EVAL_VERDICT_DIR=/tmp/eval-verdicts

TESSL_TOKEN=