# Pinned tool versions for the eval harness (R19).
# Changing any pin runs the full scenario matrix in CI.
CLAUDE_CODE_VERSION=2.1.179
EVAL_MODEL=claude-opus-4-8
OTELCOL_CONTRIB_VERSION=0.163.1
# SHA-256 checksums of the otelcol-contrib release archives, from
# the otelcol-contrib_<version>_<os>_<arch>.tar.gz.sha256 assets on the
# v0.163.1 GitHub release.
OTELCOL_CONTRIB_SHA256_LINUX_AMD64=e93e6fd2b59427420a9e8eba5b9e78260df6d21e95283a7298084d2aa07f9df7
OTELCOL_CONTRIB_SHA256_LINUX_ARM64=5ac4fb93e9858f6c7b5d5b2e81991dded61ca14b1a29bb01c3364e69567c76e3
OTELCOL_CONTRIB_SHA256_DARWIN_ARM64=c25aa7abb438d0474ffec02b0abeb04aeb688ad72e083cc1af0bed1f84dae856
# Pinned OpenTelemetry Go SDK module versions used to compile complete Go SDK
# code blocks in skills/ (see evals/examples/code.go). The stable modules share
# the OTEL_GO_CORE_VERSION line; the log and log-exporter modules track the
# separate v0.x pre-release line under OTEL_GO_LOG_VERSION.
OTEL_GO_CORE_VERSION=1.44.0
OTEL_GO_LOG_VERSION=0.20.0
# Dash0 CLI the AWS Lambda scenarios read telemetry back with; the checksum is
# the dash0_<version>_linux_amd64.tar.gz entry of checksums.txt on the
# v1.19.0 GitHub release of dash0hq/dash0-cli.
DASH0_CLI_VERSION=1.19.0
DASH0_CLI_SHA256_LINUX_AMD64=a6200fb685038138da369ad8c9543f04c467d82b344506fcc4bd0e66ddf5527b
# Maven the Java AWS Lambda fixtures build with; the checksum is the
# apache-maven-<version>-bin.tar.gz.sha512 file Apache publishes next to the
# archive.
MAVEN_VERSION=3.9.16
MAVEN_SHA512=831a8591fe20c8243b1dbe7d71e3244f31d1665b0804b2e825e38cbbe5ce0cafb8338851f90780735568773e0a6cd07bbec107cda0b896b008b861075358b6f6
# Rust toolchain and cargo-lambda the Rust AWS Lambda fixture builds with;
# cargo-lambda cross-compiles to arm64 through the pinned Zig wheel.
RUST_VERSION=1.99.0
CARGO_LAMBDA_VERSION=1.9.2
ZIGLANG_VERSION=0.16.0
