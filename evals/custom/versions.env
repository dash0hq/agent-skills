# Pinned tool versions for the eval harness (R19).
# Changing any pin runs the full scenario matrix in CI.
CLAUDE_CODE_VERSION=2.1.179
EVAL_MODEL=claude-opus-4-8
OTELCOL_CONTRIB_VERSION=0.156.0
# SHA-256 checksums of the otelcol-contrib release archives, from
# opentelemetry-collector-releases_otelcol-contrib_checksums.txt on the
# v0.156.0 GitHub release.
OTELCOL_CONTRIB_SHA256_LINUX_AMD64=ee70d7b1221be8a9cc4700f48bf985c04b1ab8aaeef24409fe79623849e2f9f2
OTELCOL_CONTRIB_SHA256_LINUX_ARM64=1f9afe1d245b4babbb4bcb7d6b57ba2836b3b23c5f61b38abc00ab461f049288
OTELCOL_CONTRIB_SHA256_DARWIN_ARM64=f5e3a6fbc8cca5e9fc9ce642c5ca16da084b4b6fea3f38a8ad29eea69ddf8e0f
# Pinned OpenTelemetry Go SDK module versions used to compile complete Go SDK
# code blocks in skills/ (see evals/examples/code.go). The stable modules share
# the OTEL_GO_CORE_VERSION line; the log and log-exporter modules track the
# separate v0.x pre-release line under OTEL_GO_LOG_VERSION.
OTEL_GO_CORE_VERSION=1.44.0
OTEL_GO_LOG_VERSION=0.20.0
